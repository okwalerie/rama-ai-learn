{:mvn/repos {"nexus-releases" {:url "https://nexus.redplanetlabs.com/repository/maven-public-releases"}}
 :deps {org.clojure/clojure {:mvn/version "1.12.4"}
        rama-challenges/rama-deps {:local/root "../../lib/rama-deps"}
        rama-challenges/harness {:local/root "../../lib/harness"}
        com.biffweb/core {:mvn/version "2.0.5"}
        com.biffweb/graph {:mvn/version "2.0.5"}}
 :paths ["src" "../../implementations/biff-rama-adapter/src"]
 :aliases {:test {:extra-paths ["../../implementations/biff-rama-adapter/test"]
                  :extra-deps {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
                  :exec-fn cognitect.test-runner.api/test :exec-args {:dirs ["src" "../../implementations/biff-rama-adapter/test"]}}
           :test-private {:extra-paths ["test-private"]
                          :extra-deps {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
                          :exec-fn cognitect.test-runner.api/test :exec-args {:dirs ["test-private"]}}
           :test-private-harness {:replace-paths ["src" "test-private" "test-resources"]
                                  :extra-deps {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
                                  :exec-fn cognitect.test-runner.api/test :exec-args {:dirs ["test-private"]}}
           :nrepl {:extra-deps {nrepl/nrepl {:mvn/version "1.3.0"}} :main-opts ["-m" "nrepl.cmdline"]}}}
